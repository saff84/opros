# Public URL without a trailing slash. For HTTPS, change this together with DOMAIN.
PUBLIC_ORIGIN=http://localhost:8080
# Generate a unique value, at least 16 characters. Never send it to respondents.
ADMIN_PASSWORD=
# Only needed for the HTTPS deployment with Caddy.
DOMAIN=survey.example.ru
# Keep loopback with Caddy or existing Nginx. For an HTTP-only test by IP, use 0.0.0.0.
BIND_ADDRESS=127.0.0.1
APP_PORT=8080
